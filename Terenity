$('guideDismiss').onclick=closeGuide;
$('guideStart').onclick=closeGuide;

/* ---------- Sjednocení mapy, podkladů a vrstvy pojmenování napříč všemi kartami ---------- */
function syncUnifiedControls(){
 $('basemap').value=S.basemap;
 document.querySelectorAll('select.unified-basemap').forEach(el=>{el.value=S.basemap});
 $('labelsOn').checked=S.labels;
 document.querySelectorAll('input.unified-labels').forEach(el=>{el.checked=S.labels});
}
function setUnifiedBasemap(val){
 S.basemap=(val==='otm'||val==='osm')?val:'none';
 saveS();
 syncUnifiedControls();
 dirty=true;
}
function setUnifiedLabels(val){
 S.labels=!!val;
 saveS();
 syncUnifiedControls();
 dirty=true;
 if(S.labels&&!S.offline)fetchPoisViewport();
}

/* ---------- UI ---------- */
function setMode(m){mode=m;document.body.dataset.m=m;document.querySelectorAll('#tabs button').forEach(b=>b.classList.toggle('on',+b.dataset.m===m));if(m===3)updateTowerSelect();reqRecompute();setTimeout(()=>{if(m===1)drawHorizon();if(m===2)drawProfile()},60)}
document.querySelectorAll('#tabs button').forEach(b=>b.onclick=()=>setMode(+b.dataset.m));
$('grab').onclick=()=>$('sheet').classList.toggle('min');
$('fZi').onclick=()=>{zoomAround(W/2,H/2,.7);scheduleGrid()};$('fZo').onclick=()=>{zoomAround(W/2,H/2,-.7);scheduleGrid()};
$('fGps').onclick=toggleGps;$('fRe').onclick=()=>buildGrid();$('fSet').onclick=()=>{$('settings').hidden=false};$('closeSet').onclick=()=>{$('settings').hidden=true};
function syncPan(){$('fPan').textContent=S.oneFinger==='pan'?'✋':'☝';$('fPan').dataset.tip=S.oneFinger==='pan'?'1 prst: posun mapy':'1 prst: výběr bodu'}
$('fPan').onclick=()=>{S.oneFinger=S.oneFinger==='pan'?'act':'pan';saveS();syncPan();toast(S.oneFinger==='pan'?'1 prst = posun mapy (výběr bodu vypnut)':'1 prst = výběr bodu (posun dvěma prsty)')};
const tl=()=>{const m=+$('time').value;$('tlabel').textContent=pad(Math.floor(m/60))+':'+pad(m%60)};
$('time').oninput=()=>{tl();reqRecompute()};
$('date').onchange=()=>{sdStale=true;reqRecompute();updateStatus()};
function setNow(){const n=new Date();$('date').value=`${n.getFullYear()}-${pad(n.getMonth()+1)}-${pad(n.getDate())}`;$('time').value=n.getHours()*60+n.getMinutes();tl();sdStale=true;reqRecompute()}
$('now').onclick=setNow;
let playT=null;$('play').onclick=()=>{if(playT){clearInterval(playT);playT=null;$('play').textContent='▶';return}$('play').textContent='⏸';playT=setInterval(()=>{$('time').value=(+$('time').value+4)%1440;tl();reqRecompute()},130)};
$('setA').onclick=()=>{nextAB='A';$('nextAB').textContent='A'};$('setB').onclick=()=>{nextAB='B';$('nextAB').textContent='B'};
$('clrAB').onclick=()=>{A=B=null;nextAB='A';PR=null;profHover=null;$('nextAB').textContent='A';$('profTip').textContent='';reqRecompute()};
$('lidarOn').onchange=()=>{S.lidarOn=$('lidarOn').checked;saveS();updateLidarBadge();reqRecompute()};
$('lidarStyle').onchange=()=>{S.detail=$('lidarStyle').value;lidarState={ok:0,err:0,srcName:'',fallback:false};localLidarKey='';updateLidarBadge();saveS();dirty=true};
$('lidarOpac').oninput=()=>{S.lidarOpac=+$('lidarOpac').value;$('lidarOpacV').textContent=S.lidarOpac;saveS();dirty=true};
$('lidarBlend').onchange=()=>{S.lidarBlend=$('lidarBlend').value;saveS();dirty=true};
$('hypsoOn').onchange=()=>{S.hypsoOn=$('hypsoOn').checked;saveS();reqRecompute()};
$('windLidar').onchange=()=>{S.windLidar=$('windLidar').checked;saveS();reqRecompute()};
$('windLidarOpac').oninput=()=>{S.windLidarOpac=+$('windLidarOpac').value;$('windLidarOpacV').textContent=S.windLidarOpac;saveS();dirty=true};
$('slopeMap').onchange=reqRecompute;$('slopeThr').onchange=()=>{S.slopeThr=+$('slopeThr').value;saveS();reqRecompute()};
$('profCanvas').addEventListener('pointerdown',profPointer);$('profCanvas').addEventListener('pointermove',e=>{if(e.buttons||e.pointerType==='mouse')profPointer(e)});
[['obsH','obsV'],['tgtH','tgtV'],['vsR','rngV']].forEach(([a,b])=>{$(a).oninput=()=>{$(b).textContent=$(a).value;reqRecompute()}});
$('towerSel').onchange=()=>{
 const id=$('towerSel').value;if(!id)return;
 const t=pois.find(p=>p.id===id);if(!t)return;
 obs={lat:t.lat,lon:t.lon};sel=obs;
 V.u=lon2u(t.lon);V.v=lat2v(t.lat);
 const th=t.th||18;$('obsH').value=clamp(th,0,400);$('obsV').textContent=$('obsH').value;
 if(+$('vsR').value<15){$('vsR').value=50;$('rngV').textContent='50'}
 onSel();buildGrid();
};
$('towerRefresh').onclick=()=>{if(S.offline)toast('V offline režimu se používají uložené rozhledny.');else{toast('Načítám objekty v okolí…',2500);fetchPoisViewport(true)}};
$('wpAddSel').onclick=()=>addWaypoint(sel);
$('wpAddGps').onclick=()=>addWaypoint(gps);
$('wpExport').onclick=exportWaypoints;
$('wpImportBtn').onclick=()=>$('wpImportFile').click();
$('wpImportFile').onchange=e=>{importWaypoints(e.target.files[0]).catch(err=>toast('Chyba importu: '+err.message,5000));e.target.value=''};
$('wpList').onclick=e=>{
 const go=e.target.closest('[data-wp-go]'),del=e.target.closest('[data-wp-del]');
 if(go){const w=waypoints.find(x=>x.id===go.dataset.wpGo);if(w){sel={lat:w.lat,lon:w.lon};V.u=lon2u(w.lon);V.v=lat2v(w.lat);if(V.z<13)V.z=14;hzStale=true;onSel();buildGrid()}}
 if(del)delWaypoint(del.dataset.wpDel);
};
function setWind(v){wind=((+v%360)+360)%360;$('windR').value=wind;$('windV').textContent=`${Math.round(wind)}° (${windName(wind)})`;reqRecompute()}
$('windR').oninput=()=>setWind($('windR').value);$('shDist').onchange=reqRecompute;
DIRS.forEach((d,i)=>{const b=document.createElement('button');b.textContent=d;b.style.minWidth='42px';b.dataset.tip=`Vítr ze směru ${d}`;b.dataset.tipDesc=`Nastaví směr větru na ${i*45}° (${d}).`;b.onclick=()=>setWind(i*45);$('windQ').appendChild(b)});
$('wxWind').onclick=()=>{if(wx&&typeof wx.wind_direction_10m==='number'){setWind(wx.wind_direction_10m);toast(`Vítr z Open-Meteo: ${wx.wind_direction_10m}°, ${wx.wind_speed_10m} km/h`)}else toast('Aktuální vítr z Open-Meteo není k dispozici (vyberte bod na mapě a buďte online).')};
$('labelsOn').onchange=()=>$('labelsOn').checked?setUnifiedLabels(true):setUnifiedLabels(false);
document.querySelectorAll('input.unified-labels').forEach(el=>{el.onchange=()=>setUnifiedLabels(el.checked)});
$('basemap').onchange=()=>setUnifiedBasemap($('basemap').value);
document.querySelectorAll('select.unified-basemap').forEach(el=>{el.onchange=()=>setUnifiedBasemap(el.value)});
$('satOn').onchange=()=>{S.satOn=$('satOn').checked;saveS();reqRecompute()};
$('satOpac').oninput=()=>{S.satOpac=+$('satOpac').value;$('satOpacV').textContent=S.satOpac;saveS();dirty=true};
document.querySelectorAll('#vsRQuick [data-r]').forEach(b=>{b.onclick=()=>{$('vsR').value=b.dataset.r;$('rngV').textContent=b.dataset.r;reqRecompute()}});
$('opac').oninput=()=>{S.opac=+$('opac').value;$('opacV').textContent=S.opac;saveS();dirty=true};
$('contour').onchange=()=>{S.contour=+$('contour').value;saveS();reqRecompute()};
$('gridN').onchange=()=>{S.N=+$('gridN').value;saveS();buildGrid()};
$('autoGrid').onchange=()=>{S.auto=$('autoGrid').checked;saveS()};
$('offline').onchange=()=>{S.offline=$('offline').checked;saveS();if(S.offline){toast('Offline režim zapnut – síť se nepoužívá.');wx=null;updateStatus()}else if(sel)onSel();buildGrid();dirty=true};
$('regSel').innerHTML=KRAJE.map(k=>`<option>${k.name}</option>`).join('');$('regSel').onchange=regEstimate;$('regZ').onchange=regEstimate;
$('regDl').onclick=downloadRegion;$('regCancel').onclick=()=>{dlAbort=true};
$('regList').onclick=e=>{const d=e.target.dataset;if(d.del)delRegion(d.del);if(d.ver)verRegion(d.ver)};
$('hgtFile').onchange=e=>{loadHgt([...e.target.files]).catch(err=>toast('Chyba čtení HGT: '+err.message,5000));e.target.value=''};
$('hgtOn').onchange=()=>{S.hgtOn=$('hgtOn').checked;saveS();buildGrid()};
$('hgtList').onclick=e=>{const n=e.target.dataset.hgt;if(n){e.preventDefault();hgts=hgts.filter(h=>h.name!==n);renderHgt();buildGrid()}};
$('p0').onchange=()=>{S.P0=+$('p0').value||1013.25;saveS();updateStatus()};
$('tref').onchange=()=>{S.Tref=$('tref').value;saveS();updateStatus()};
new ResizeObserver(()=>{document.documentElement.style.setProperty('--sh',$('sheet').offsetHeight+'px');drawHorizon();drawProfile()}).observe($('sheet'));
window.addEventListener('resize',()=>{resize();scheduleGrid()});
window.addEventListener('online',()=>{if(!S.offline)buildGrid()});

/* ---------- start ---------- */
(function init(){
 resize();setNow();tl();syncPan();
 $('lidarOn').checked=S.lidarOn;$('lidarStyle').value=S.detail;$('lidarOpac').value=S.lidarOpac;$('lidarOpacV').textContent=S.lidarOpac;$('lidarBlend').value=S.lidarBlend;$('hypsoOn').checked=S.hypsoOn;$('windLidar').checked=S.windLidar;$('windLidarOpac').value=S.windLidarOpac;$('windLidarOpacV').textContent=S.windLidarOpac;
 $('satOn').checked=S.satOn;$('satOpac').value=S.satOpac;$('satOpacV').textContent=S.satOpac;syncUnifiedControls();$('opac').value=S.opac;$('opacV').textContent=S.opac;$('contour').value=S.contour;$('gridN').value=S.N;$('autoGrid').checked=S.auto;$('offline').checked=S.offline;$('hgtOn').checked=S.hgtOn;$('p0').value=S.P0;$('tref').value=S.Tref;$('slopeThr').value=S.slopeThr;
 setWind(270);regEstimate();renderHgt();loadRegions().then(()=>{if(S.offline)buildGrid()});
 updateLidarBadge();requestAnimationFrame(frame);buildGrid();
 if(!S.guideSeen)$('guideModal').hidden=false;
})();
</script>
</body>
</html>
