function fit(c){const r=c.getBoundingClientRect();if(r.width<5||r.height<5)return null;c.width=Math.round(r.width*DPR);c.height=Math.round(r.height*DPR);const x=c.getContext('2d');x.setTransform(DPR,0,0,DPR,0,0);return{x,w:r.width,h:r.height}}

