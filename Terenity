/* ---------- ČÚZK LIDAR DMR 5G ---------- */
const lidarImgs=new Map();
let lidarState={ok:0,err:0,srcName:'',fallback:false};
function u2wm(u){return(u*2-1)*20037508.342789244}
function v2wm(v){return(1-v*2)*20037508.342789244}
function updateLidarBadge(){
 const el=$('lidarStatus');if(!el)return;
 if(!S.lidarOn){el.textContent='';return}
 if(lidarState.ok>0){el.textContent='● ČÚZK aktivní';el.style.color='#66bb6a'}
 else if(lidarState.fallback||S.offline){el.textContent='● reliéfní filtr (lokální DEM)';el.style.color='#4fc3f7'}
 else{el.textContent='načítám ČÚZK…';el.style.color='#4fc3f7'}
}
function lidarUrls(rule,bbox,bbox4326){
 const rr=rule&&rule!=='Default'?'&renderingRule='+encodeURIComponent(JSON.stringify({rasterFunction:rule})):'';
 return [
  `https://ags.cuzk.gov.cz/arcgis2/rest/services/dmr5g/ImageServer/exportImage?bbox=${bbox}&bboxSR=3857&imageSR=3857&size=512,512&format=png32&transparent=true&f=image${rr}`,
  `https://ags.cuzk.gov.cz/arcgis2/rest/services/dmr5g/ImageServer/exportImage?bbox=${bbox}&bboxSR=3857&imageSR=3857&size=512,512&format=png&f=image`,
  `https://ags.cuzk.gov.cz/arcgis2/services/dmr5g/ImageServer/WMSServer?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&LAYERS=0&STYLES=&CRS=EPSG:3857&BBOX=${bbox}&WIDTH=512&HEIGHT=512&FORMAT=image/png&TRANSPARENT=TRUE`,
  `https://geoportal.cuzk.cz/WMS_DMR5G/WMService.aspx?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&LAYERS=GR_DMR5G&STYLES=&CRS=EPSG:4326&BBOX=${bbox4326}&WIDTH=512&HEIGHT=512&FORMAT=image/png&TRANSPARENT=TRUE`
 ];
}
function lidarTile(rule,z,x,y){
 const k=rule+'/'+z+'/'+x+'/'+y;
 let im=lidarImgs.get(k);
 if(!im){
  im=new Image();
  im.referrerPolicy='no-referrer';
  const n=2**z,u0=x/n,u1=(x+1)/n,v0=y/n,v1=(y+1)/n;
  const bbox=`${u2wm(u0).toFixed(2)},${v2wm(v1).toFixed(2)},${u2wm(u1).toFixed(2)},${v2wm(v0).toFixed(2)}`;
  const bbox4326=`${v2lat(v1).toFixed(6)},${u2lon(u0).toFixed(6)},${v2lat(v0).toFixed(6)},${u2lon(u1).toFixed(6)}`;
  const urls=lidarUrls(rule,bbox,bbox4326);
  im.step=0;
  im.onload=()=>{lidarState.ok++;lidarState.fallback=false;updateLidarBadge();dirty=true};
  im.onerror=()=>{
   im.step++;
   if(im.step<urls.length){im.src=urls[im.step];return}
   im.bad=true;lidarState.err++;
   if(lidarState.ok===0)lidarState.fallback=true;
   updateLidarBadge();dirty=true;
  };
  im.src=urls[0];
  lidarImgs.set(k,im);
  if(lidarImgs.size>240)lidarImgs.delete(lidarImgs.keys().next().value);
 }
 return im;
}

let localLidarCvs=null,localLidarCtx=null,localLidarImg=null,localLidarKey='';
function renderLocalLidarFilter(){
 if(!G)return null;
 const key=`${G.u0}_${G.v0}_${G.nx}_${S.detail}`;
 if(localLidarCvs&&localLidarKey===key)return localLidarCvs;
 const{nx,ny,GX,GY,SL}=G;
 if(!localLidarCvs||localLidarCvs.width!==nx||localLidarCvs.height!==ny){
  localLidarCvs=document.createElement('canvas');localLidarCvs.width=nx;localLidarCvs.height=ny;
  localLidarCtx=localLidarCvs.getContext('2d');localLidarImg=localLidarCtx.createImageData(nx,ny);
 }
 const d=localLidarImg.data,st=S.detail;
 for(let k=0;k<nx*ny;k++){
  const gx=GX[k]*2.2,gy=GY[k]*2.2,inv=1/Math.sqrt(1+gx*gx+gy*gy);
  let r=128,g=128,b=128;
  if(st==='Slope'){
   const s=clamp(SL[k]/45,0,1);
   r=Math.round(40+215*s);g=Math.round(220*(1-s*0.75));b=Math.round(60*(1-s));
  }else if(st==='Aspect'){
   const az=(Math.atan2(-gx,-gy)*R2D+360)%360;
   const c=Math.min(1,SL[k]/12);
   const h=az/60,x=1-Math.abs(h%2-1);
   let rr=0,gg=0,bb=0;
   if(h<1){rr=1;gg=x}else if(h<2){rr=x;gg=1}else if(h<3){gg=1;bb=x}else if(h<4){gg=x;bb=1}else if(h<5){rr=x;bb=1}else{rr=1;bb=x}
   r=Math.round(128+(rr*255-128)*c);g=Math.round(128+(gg*255-128)*c);b=Math.round(128+(bb*255-128)*c);
  }else if(st==='MultidirectionalHillshade'){
   const i1=Math.max(0,(-gx*-.5-gy*.5+.707)*inv);
   const i2=Math.max(0,(-gx*.5-gy*.5+.707)*inv);
   const i3=Math.max(0,(-gx*0-gy*.707+.707)*inv);
   const v=clamp((0.5*i1+0.3*i2+0.2*i3)*275,15,250);
   r=g=b=v;
  }else{
   const ill=Math.max(0,(-gx*-.55-gy*.55+.63)*inv);
   const v=clamp(ill*270,12,250);
   r=g=b=v;
  }
  const p=k*4;d[p]=r;d[p+1]=g;d[p+2]=b;d[p+3]=255;
 }
 localLidarCtx.putImageData(localLidarImg,0,0);
 localLidarKey=key;
 return localLidarCvs;
}

function drawLidarLayer(sc,alpha=1,blend='source-over'){
 if(alpha<=0)return;
 let drewTile=0;
 if(!S.offline){
  const tz=clamp(Math.round(V.z-0.3),7,16),n=2**tz,ts=sc/n;
  const xa=Math.max(0,Math.floor((V.u-W/2/sc)*n)),xb=Math.min(n-1,Math.floor((V.u+W/2/sc)*n));
  const ya=Math.max(0,Math.floor((V.v-H/2/sc)*n)),yb=Math.min(n-1,Math.floor((V.v+H/2/sc)*n));
  if((xb-xa+1)*(yb-ya+1)<=48){
   ctx.save();
   ctx.globalAlpha=alpha;
   ctx.globalCompositeOperation=blend;
   for(let y=ya;y<=yb;y++)for(let x=xa;x<=xb;x++){
    const im=lidarTile(S.detail,tz,x,y);
    if(im.complete&&im.naturalWidth){
     ctx.drawImage(im,(x/n-V.u)*sc+W/2,(y/n-V.v)*sc+H/2,ts+.5,ts+.5);
     drewTile++;
    }
   }
   ctx.restore();
  }
 }
 if(!drewTile&&G){
  const lc=renderLocalLidarFilter();
  if(lc){
   ctx.save();
   ctx.globalAlpha=alpha;
   ctx.globalCompositeOperation=blend;
   ctx.imageSmoothingEnabled=true;
   ctx.drawImage(lc,(G.u0-V.u)*sc+W/2,(G.v0-V.v)*sc+H/2,G.nx*G.cu*sc,G.ny*G.cu*sc);
   ctx.restore();
  }
 }
}

