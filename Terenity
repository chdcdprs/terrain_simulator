/* ---------- výpočetní grid ---------- */
function showBusy(b){$('busy').style.display=b?'block':'none'}
async function makeGrid(uc,vc,side,N,maxZ=13){
 const cu=side/N,u0=uc-side/2,v0=vc-side/2;
 const latc=v2lat(vc),dx=cu*CIRC*Math.cos(latc*D2R);
 let zt=Math.round(Math.log2(CIRC*Math.cos(latc*D2R)/(256*dx)));zt=clamp(zt,5,maxZ);
 if(S.offline){const zs=regions.map(r=>r.zoom);if(zs.length)zt=zs.reduce((a,b)=>Math.abs(b-zt)<Math.abs(a-zt)?b:a)}
 let n,tx0,tx1,ty0,ty1;
 for(;;){n=2**zt;const m=1/(256*n);tx0=Math.floor((u0-m)*n);tx1=Math.floor((u0+side+m)*n);ty0=Math.floor((v0-m)*n);ty1=Math.floor((v0+side+m)*n);const c=(tx1-tx0+1)*(ty1-ty0+1);if(c<=36||zt<=5)break;if(S.offline&&c<=100)break;if(S.offline)return{err:'too_far'};zt--}
 const mw=(tx1-tx0+1)*256,mh=(ty1-ty0+1)*256,mos=new Float32Array(mw*mh);let miss=0;netFail=false;
 const jobs=[];for(let ty=ty0;ty<=ty1;ty++)for(let tx=tx0;tx<=tx1;tx++)jobs.push([tx,ty]);
 await Promise.all(jobs.map(async([tx,ty])=>{
  const t=(ty<0||ty>=n)?null:await getTile(zt,((tx%n)+n)%n,ty,!S.offline);
  if(!t){miss++;return}
  const bx=(tx-tx0)*256,by=(ty-ty0)*256;for(let r=0;r<256;r++)mos.set(t.subarray(r*256,r*256+256),(by+r)*mw+bx)}));
 const nzs=n*256,sxA=new Float32Array(N),syA=new Float32Array(N),lonA=new Float64Array(N),latA=new Float64Array(N);
 for(let i=0;i<N;i++){const u=u0+(i+.5)*cu;sxA[i]=u*nzs-.5-tx0*256;lonA[i]=u2lon(u);const v=v0+(i+.5)*cu;syA[i]=v*nzs-.5-ty0*256;latA[i]=v2lat(v)}
 const Hh=new Float32Array(N*N);
 for(let j=0,k=0;j<N;j++){let sy=syA[j],y0=Math.floor(sy),fy=sy-y0;if(y0<0){y0=0;fy=0}else if(y0>mh-2){y0=mh-2;fy=1}
  for(let i=0;i<N;i++,k++){let sx=sxA[i],x0=Math.floor(sx),fx=sx-x0;if(x0<0){x0=0;fx=0}else if(x0>mw-2){x0=mw-2;fx=1}
   const p=y0*mw+x0;Hh[k]=mos[p]*(1-fx)*(1-fy)+mos[p+1]*fx*(1-fy)+mos[p+mw]*(1-fx)*fy+mos[p+mw+1]*fx*fy}}
 if(S.hgtOn&&hgts.length){for(let j=0,k=0;j<N;j++){const lat=latA[j];for(let i=0;i<N;i++,k++){const lon=lonA[i];for(const h of hgts){if(lat>=h.lat&&lat<h.lat+1&&lon>=h.lon&&lon<h.lon+1){const fx=(lon-h.lon)*(h.n-1),fy=(h.lat+1-lat)*(h.n-1),x0=Math.min(fx|0,h.n-2),y0=Math.min(fy|0,h.n-2),ax=fx-x0,ay=fy-y0,p=y0*h.n+x0,d=h.d,a=d[p],b=d[p+1],c=d[p+h.n],e=d[p+h.n+1];if(a>-1000&&b>-1000&&c>-1000&&e>-1000)Hh[k]=a*(1-ax)*(1-ay)+b*ax*(1-ay)+c*(1-ax)*ay+e*ax*ay;break}}}}}
 const GX=new Float32Array(N*N),GY=new Float32Array(N*N),INV=new Float32Array(N*N),SL=new Float32Array(N*N);let mn=1e9,mx=-1e9;
 for(let j=0;j<N;j++){const jm=Math.max(j-1,0)*N,j0=j*N,jp=Math.min(j+1,N-1)*N;for(let i=0;i<N;i++){const im=Math.max(i-1,0),ip=Math.min(i+1,N-1),k=j0+i,h=Hh[k];if(h<mn)mn=h;if(h>mx)mx=h;
  const gx=((Hh[jm+ip]+2*Hh[j0+ip]+Hh[jp+ip])-(Hh[jm+im]+2*Hh[j0+im]+Hh[jp+im]))/(8*dx*(ip-im)/2),gj=((Hh[jp+im]+2*Hh[jp+i]+Hh[jp+ip])-(Hh[jm+im]+2*Hh[jm+i]+Hh[jm+ip]))/(8*dx*(jp-jm)/(2*N)),gy=-gj;
  GX[k]=gx;GY[k]=gy;INV[k]=1/Math.sqrt(1+gx*gx+gy*gy);SL[k]=Math.atan(Math.hypot(gx,gy))*R2D}}
 return{grid:{nx:N,ny:N,u0,v0,cu,dx,H:Hh,GX,GY,INV,SL,min:mn,max:mx,zt,latc,lonc:u2lon(uc),shadow:null,vs:null,W:null,L:null},miss};
}

async function buildGrid(){
 if(building){pendingBuild=true;return}
 building=true;pendingBuild=false;showBusy(true);
 try{
  if(S.offline&&!regions.length&&!hgts.length)toast('Offline režim: nejsou stažená žádná data (Nastavení → Offline).',5000);
  const N=+S.N,sc=scale(),side=Math.max(W,H)*1.15/sc;
  const res=await makeGrid(V.u,V.v,side,N,13);
  if(res.err==='too_far'){toast('Příliš oddáleno pro offline data – přibližte mapu.');building=false;showBusy(false);return}
  const g=res.grid,i0=clamp(Math.floor((V.u-W/2/sc-g.u0)/g.cu),0,N-1),i1=clamp(Math.ceil((V.u+W/2/sc-g.u0)/g.cu),0,N-1),j0=clamp(Math.floor((V.v-H/2/sc-g.v0)/g.cu),0,N-1),j1=clamp(Math.ceil((V.v+H/2/sc-g.v0)/g.cu),0,N-1);
  g.vp={i0,i1,j0,j1};G=g;
  hzStale=true;needRecompute=true;dirty=true;
  if(res.miss&&S.offline)toast(`Offline: chybí ${res.miss} dlaždic v databázi – místo nich je výška 0 m.`,5000);
  else if(netFail)toast('Síť není dostupná – použita jen offline data.',5000);
  updateStatus();
  if(!S.offline)fetchPoisViewport();
 }catch(e){toast('Chyba při sestavení gridu: '+(e.message||e),5000)}
 building=false;showBusy(false);if(pendingBuild)buildGrid()}
let gT=null;function scheduleGrid(){clearTimeout(gT);gT=setTimeout(()=>{if(S.auto)buildGrid()},550)}
function ll2g(lat,lon,g=G){if(!g)return null;const x=(lon2u(lon)-g.u0)/g.cu-.5,y=(lat2v(lat)-g.v0)/g.cu-.5;return{x,y,in:x>=0&&y>=0&&x<=g.nx-1&&y<=g.ny-1}}
function sampleG(x,y,g=G){const nx=g.nx;if(x<0||y<0||x>nx-1||y>g.ny-1)return NaN;const ix=Math.min(x|0,nx-2),iy=Math.min(y|0,g.ny-2),ax=x-ix,ay=y-iy,p=iy*nx+ix,h=g.H;return h[p]*(1-ax)*(1-ay)+h[p+1]*ax*(1-ay)+h[p+nx]*(1-ax)*ay+h[p+nx+1]*ax*ay}
function elevAt(p){if(!G||!p)return NaN;const g=ll2g(p.lat,p.lon);return g.in?sampleG(g.x,g.y):NaN}
const hav=(a,b)=>{const dl=(b.lat-a.lat)*D2R,dn=(b.lon-a.lon)*D2R,q=Math.sin(dl/2)**2+Math.cos(a.lat*D2R)*Math.cos(b.lat*D2R)*Math.sin(dn/2)**2;return 2*EARTH*Math.asin(Math.sqrt(q))};

/* ---------- POI: města, obce, vrcholy, rozhledny, zříceniny, podzemí ---------- */
function parseOverpassPois(data){
 const out=[];if(!data||!data.elements)return out;
 for(const el of data.elements){
  const lat=el.lat||(el.center&&el.center.lat),lon=el.lon||(el.center&&el.center.lon);
  if(typeof lat!=='number'||typeof lon!=='number')continue;
  const t=el.tags||{};
  let kind='peak',prio=4,h=parseFloat(t.ele)||null,th=parseFloat(t.height)||null;
  if(t.place==='city'){kind='city';prio=1}
  else if(t.place==='town'){kind='town';prio=2}
  else if(t.place==='village'||t.place==='suburb'){kind='village';prio=3}
  else if(t['tower:type']==='observation'||t.man_made==='observation_tower'){kind='tower';prio=2}
  else if(t.historic==='ruins'||t.historic==='castle'||t.historic==='fort'){kind='ruin';prio=3}
  else if(t.natural==='cave_entrance'||t.man_made==='adit'||t.man_made==='mineshaft'||t.military==='bunker'){kind='underground';prio=3}
  else if(t.natural==='peak'||t.natural==='hill'){kind='peak';prio=t.natural==='peak'?3:4}
  const defName=kind==='tower'?'Rozhledna':kind==='ruin'?'Zřícenina':kind==='underground'?(t.military==='bunker'?'Bunkr':t.natural==='cave_entrance'?'Jeskyně':'Štola / podzemí'):null;
  const name=t.name||defName;
  if(!name)continue;
  out.push({id:el.type[0]+el.id,lat,lon,name,kind,prio,ele:h,th:th});
 }
 return out;
}
function mergePois(list){
 const map=new Map();for(const p of pois)map.set(p.id,p);for(const p of list)map.set(p.id,p);
 pois=[...map.values()];updateTowerSelect();dirty=true;
}
