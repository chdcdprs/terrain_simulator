<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="TERENITY">
<meta name="theme-color" content="#0a0f16">
<title>TERENITY – Terénní a 3D mapový simulátor ČR</title>
<style>
:root{
 --bg:#0a0f16;--bg2:#0d141d;--pn:rgba(15,22,32,.88);--pnsolid:#111924;--bd:#223246;--bd2:#2f445e;
 --tx:#eaf2f9;--mu:#8fa0b3;--ac:#35c0e8;--ac2:#4fc3f7;--acd:#0e7fa8;--violet:#8b7bff;
 --ok:#3ddc8a;--warn:#ffb74d;--danger:#ef5350;
 --sat:env(safe-area-inset-top,0px);--sab:env(safe-area-inset-bottom,0px);
 --sh:260px;--sw:410px;--r-lg:18px;--r-md:12px;--r-sm:9px;
 --shadow-1:0 2px 12px rgba(0,0,0,.38);--shadow-2:0 12px 36px rgba(0,0,0,.52);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--tx);font:14px/1.42 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;overflow:hidden;overscroll-behavior:none;-webkit-user-select:none;user-select:none;letter-spacing:.1px}
#map{position:fixed;inset:0;width:100%;height:100%;touch-action:none;display:block;background:radial-gradient(ellipse at 50% 0%,#101a26 0%,var(--bg) 70%)}
button,select,input{font:inherit;color:var(--tx)}
button{background:linear-gradient(180deg,#223040,#192430);border:1px solid var(--bd);border-radius:var(--r-md);padding:9px 13px;min-height:42px;touch-action:manipulation;cursor:pointer;font-weight:600;font-size:13px;transition:transform .12s,background .15s,border-color .15s,box-shadow .15s;box-shadow:0 1px 0 rgba(255,255,255,.04) inset}
button:hover{border-color:var(--bd2)}
button:active{transform:scale(.96)}
button.on,button:active{background:linear-gradient(180deg,#0f7fa8,#0b6488);border-color:var(--ac);color:#fff;box-shadow:0 0 0 1px rgba(53,192,232,.35),0 4px 14px rgba(20,140,180,.3)}
input[type=date],input[type=number],input[type=text],select{background:#121b26;border:1px solid var(--bd);border-radius:var(--r-sm);padding:9px 10px;min-height:42px;max-width:100%;transition:border-color .15s}
input[type=date]:focus,input[type=number]:focus,input[type=text]:focus,select:focus{outline:none;border-color:var(--ac)}
input[type=range]{width:100%;min-height:34px;accent-color:var(--ac)}

/* ---------- top app bar & brand ---------- */
#top{position:fixed;left:0;right:0;top:0;padding:calc(6px + var(--sat)) 8px 4px;display:flex;flex-direction:column;gap:6px;pointer-events:none;z-index:5}
#topHeader{display:flex;align-items:center;justify-content:space-between;gap:8px;pointer-events:none}
#brand{pointer-events:auto;display:inline-flex;align-items:center;gap:9px;padding:4px 11px 4px 7px;background:var(--pn);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--bd);border-radius:14px;box-shadow:var(--shadow-1);cursor:pointer}
#brand svg{width:24px;height:24px;flex:none}
#brand .bt{font-weight:800;font-size:14px;letter-spacing:1.1px;background:linear-gradient(90deg,#ffffff 0%,#7ad8f5 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
#brand .sub{font-size:10px;color:var(--mu);font-weight:600;letter-spacing:.4px;display:none}

/* ---------- vyhledávání místa ---------- */
#searchBox{pointer-events:auto;position:relative;flex:1;max-width:340px;display:flex;align-items:center}
#searchInp{width:100%;min-height:36px;height:36px;padding:6px 34px 6px 30px;font-size:13px;background:var(--pn);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--bd);border-radius:13px;box-shadow:var(--shadow-1)}
#searchInp::placeholder{color:var(--mu)}
#searchIco{position:absolute;left:10px;font-size:13px;color:var(--mu);pointer-events:none}
#searchClr{position:absolute;right:4px;min-height:28px;height:28px;width:28px;padding:0;background:transparent;border:none;box-shadow:none;color:var(--mu);font-size:14px;display:none}
#searchRes{position:absolute;top:40px;left:0;right:0;background:var(--pnsolid);border:1px solid var(--bd2);border-radius:14px;box-shadow:var(--shadow-2);max-height:260px;overflow-y:auto;z-index:40;display:none}
.sr-item{padding:9px 12px;border-bottom:1px solid var(--bd);cursor:pointer;font-size:12.5px;transition:background .12s}
.sr-item:last-child{border-bottom:none}
.sr-item:hover{background:#182433}
.sr-item b{display:block;color:var(--tx);font-size:13px}
.sr-item small{color:var(--mu);font-size:11px}

/* ---------- tabs ---------- */
#tabs{display:flex;gap:3px;pointer-events:auto;background:var(--pn);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);border:1px solid var(--bd);border-radius:16px;padding:4px;box-shadow:var(--shadow-1)}
#tabs button{flex:1;padding:7px 2px;font-size:12px;background:transparent;border:none;border-radius:12px;min-height:40px;box-shadow:none;color:var(--mu);font-weight:600;white-space:nowrap}
#tabs button.on{background:linear-gradient(180deg,#1178a0,#0a5f82);color:#fff;box-shadow:0 2px 10px rgba(17,120,160,.5)}

/* ---------- přehledný status + počasí box ---------- */
#status{pointer-events:auto;background:var(--pn);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);border:1px solid var(--bd);border-radius:14px;padding:8px 11px;font-size:12.5px;box-shadow:var(--shadow-1)}
.st-grid{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px}
.st-loc{display:flex;align-items:center;gap:6px;font-weight:600;color:var(--tx);flex-wrap:wrap}
.st-pill{display:inline-flex;align-items:center;gap:4px;background:#131e2b;border:1px solid var(--bd);border-radius:8px;padding:2px 7px;font-size:11.5px;color:#d6e4f0}
.st-pill b{color:var(--ac2);font-weight:700}
.st-wx{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px;padding-top:5px;border-top:1px solid rgba(34,50,70,.75)}
.wx-chip{display:inline-flex;align-items:center;gap:4px;background:rgba(18,29,42,.95);border:1px solid var(--bd);border-radius:8px;padding:2px 8px;font-size:11.5px;color:#dce8f3}
.wx-chip b{color:#fff}

/* ---------- floating controls ---------- */
#fabs{position:fixed;right:10px;bottom:calc(var(--sh) + 12px);display:flex;flex-direction:column;gap:7px;z-index:5}
#fabs button{width:46px;height:46px;padding:0;background:var(--pn);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);font-size:19px;border-radius:14px;box-shadow:var(--shadow-1);display:flex;align-items:center;justify-content:center}
#fabs button.gps-active{border-color:#4285f4;background:linear-gradient(180deg,#1b3b64,#132a47);box-shadow:0 0 0 1px rgba(66,133,244,.45),0 4px 14px rgba(66,133,244,.35)}
#scalebar{position:fixed;left:12px;bottom:calc(var(--sh) + 12px);font-size:11px;color:#fff;text-shadow:0 0 3px #000,0 0 3px #000;pointer-events:none;z-index:4;font-weight:600}
#scalebar i{display:block;height:5px;border:2px solid #fff;border-top:none;margin-top:2px;box-shadow:0 0 2px #000;border-radius:0 0 2px 2px}
#busy{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--pnsolid);padding:12px 18px;border-radius:var(--r-md);border:1px solid var(--bd);display:none;pointer-events:none;z-index:25;box-shadow:var(--shadow-2);font-weight:600}
#toast{position:fixed;left:50%;bottom:calc(var(--sh) + 74px);transform:translateX(-50%);background:#1b2a3a;border:1px solid var(--ac);padding:10px 16px;border-radius:14px;max-width:90%;display:none;text-align:center;z-index:30;box-shadow:var(--shadow-2);font-weight:600}

/* ---------- vlastní průhledný tooltip při najetí na tlačítko ---------- */
#hoverTip{position:fixed;z-index:60;pointer-events:none;background:rgba(13,20,30,.82);backdrop-filter:blur(12px) saturate(140%);-webkit-backdrop-filter:blur(12px) saturate(140%);border:1px solid rgba(79,195,247,.38);color:#eaf2f9;padding:7px 11px;border-radius:10px;font-size:12px;line-height:1.35;max-width:250px;box-shadow:0 8px 24px rgba(0,0,0,.45);opacity:0;transform:translateY(3px);transition:opacity .14s ease,transform .14s ease}
#hoverTip.show{opacity:1;transform:translateY(0)}
#hoverTip b{display:block;color:var(--ac2);font-size:12px;margin-bottom:2px}

/* ---------- bottom sheet / right sidebar ---------- */
#sheet{position:fixed;left:0;right:0;bottom:0;background:var(--pn);backdrop-filter:blur(18px) saturate(140%);-webkit-backdrop-filter:blur(18px) saturate(140%);border-top:1px solid var(--bd);border-radius:20px 20px 0 0;max-height:48vh;overflow-y:auto;overflow-x:hidden;padding:0 14px calc(12px + var(--sab));touch-action:pan-y;-webkit-user-select:text;user-select:text;z-index:6;box-shadow:0 -10px 40px rgba(0,0,0,.5)}
#sheet.min{max-height:36px;overflow:hidden}
#sheet::-webkit-scrollbar{width:7px}
#sheet::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:6px}
#grab{position:sticky;top:0;background:var(--pn);text-align:center;height:32px;line-height:32px;color:var(--mu);cursor:pointer;margin:0 -14px;z-index:2;font-size:12px;letter-spacing:.3px}
#grab::before{content:'';display:block;width:36px;height:4px;border-radius:3px;background:var(--bd2);margin:5px auto 0}
section{display:none;width:100%}
body[data-m="1"] section[data-m="1"],body[data-m="2"] section[data-m="2"],body[data-m="3"] section[data-m="3"],body[data-m="4"] section[data-m="4"],body[data-m="5"] section[data-m="5"]{display:block}

/* ---------- generic layout bits ---------- */
.row{display:flex;gap:7px;align-items:center;margin:7px 0;flex-wrap:wrap;width:100%}
.row>*{flex:0 1 auto;min-width:0}.row>.grow{flex:1 1 110px;min-width:0}
.info{font-size:13px;margin:7px 0;color:#c3ced9;word-wrap:break-word}
.big{font-size:23px;font-weight:700;min-width:62px;letter-spacing:.3px}
.st{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:8px 0}
.st div{background:#121b26;border:1px solid var(--bd);border-radius:var(--r-sm);padding:7px 9px;font-size:11px;color:var(--mu)}
.st b{display:block;font-size:16px;color:var(--tx);margin-top:1px}
canvas.ch{width:100%;display:block;background:#0c131c;border:1px solid var(--bd);border-radius:var(--r-sm);margin:7px 0;touch-action:none}
label{display:block;margin:7px 0;font-size:13px;color:#dbe4ec}label.chk{display:flex;gap:9px;align-items:center}
input[type=checkbox]{width:20px;height:20px;accent-color:var(--ac);flex:none}
.lg{display:inline-block;width:12px;height:12px;border-radius:4px;vertical-align:-1px;margin-right:4px}
.sec-card{background:rgba(18,27,38,.72);border:1px solid var(--bd);border-radius:14px;padding:10px 11px;margin:8px 0;width:100%}
.wp-item{display:flex;justify-content:space-between;align-items:center;gap:8px;background:#121b26;border:1px solid var(--bd);border-radius:var(--r-sm);padding:9px 11px;margin:6px 0;font-size:12.5px;width:100%;overflow:hidden}
.wp-item>span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis}
.wp-item>span:last-child{display:flex;gap:5px;flex:none}
.wp-item button{min-height:34px;padding:5px 9px;font-size:12px}

/* ---------- settings & onboarding modal ---------- */
.modal-bg{position:fixed;inset:0;background:rgba(4,7,11,.74);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:35;overflow-y:auto;padding:calc(12px + var(--sat)) 12px calc(12px + var(--sab));-webkit-user-select:text;user-select:text;display:flex;align-items:flex-start;justify-content:center}
.modal-bg[hidden]{display:none}
.card{background:var(--pnsolid);border:1px solid var(--bd);border-radius:var(--r-lg);padding:18px;width:100%;max-width:640px;margin:auto;box-shadow:var(--shadow-2)}
.card h3{margin:0 0 10px;display:flex;justify-content:space-between;align-items:center;font-size:17px}
.card h3 button{min-height:36px;padding:4px 12px}
.card h4{margin:16px 0 6px;color:var(--ac2);font-size:12.5px;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid var(--bd);padding-bottom:5px}
.note{font-size:12px;color:#ffcc80;background:#2a2112;border:1px solid #4a3a1a;border-radius:var(--r-sm);padding:9px 10px;margin:8px 0}
.bar{height:10px;background:#121b26;border-radius:6px;overflow:hidden;margin:7px 0;border:1px solid var(--bd)}.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--acd),var(--ac));transition:width .2s}
.reg{display:flex;justify-content:space-between;gap:8px;align-items:center;border-top:1px solid var(--bd);padding:8px 0;font-size:12.5px}
.reg button{min-height:36px;padding:5px 11px}
.badge{display:inline-block;padding:2px 8px;border-radius:7px;font-size:11px;background:#123246;color:var(--ac2);border:1px solid #1e4a63;font-weight:700}

/* průvodce aplikací */
.guide-grid{display:grid;grid-template-columns:1fr;gap:8px;margin:12px 0}
.guide-step{display:flex;gap:10px;align-items:flex-start;background:#131d29;border:1px solid var(--bd);border-radius:12px;padding:10px 12px}
.guide-ico{font-size:20px;line-height:1.2;flex:none;margin-top:1px}
.guide-step b{display:block;color:var(--tx);font-size:13.5px;margin-bottom:2px}
.guide-step p{margin:0;color:var(--mu);font-size:12.5px}

/* =========================================================
   DESKTOP / WIDE SCREEN
   ========================================================= */
@media (min-width:860px){
 #brand .sub{display:inline}
 #top{left:16px;right:auto;top:14px;width:auto;max-width:610px;padding:0}
 #topHeader{justify-content:flex-start}
 #searchBox{max-width:340px}
 #tabs{padding:5px}
 #tabs button{font-size:13px;padding:9px 13px;flex:0 0 auto;min-width:112px}
 #status{max-width:610px}
 #sheet{left:auto;top:14px;right:14px;bottom:14px;width:var(--sw);max-height:none;height:calc(100% - 28px);border-radius:var(--r-lg);box-shadow:var(--shadow-2);border:1px solid var(--bd);padding:12px 16px 16px}
 #sheet.min{max-height:none;overflow-y:auto}
 #grab{display:none}
 section{padding-top:2px}
 #fabs{right:auto;left:16px;bottom:16px}
 #scalebar{left:74px;bottom:22px;top:auto}
 #toast{bottom:28px}
 .modal-bg{padding:36px 20px}
 .guide-grid{grid-template-columns:1fr 1fr}
}
@media (min-width:860px) and (hover:hover){
 button:hover{box-shadow:0 2px 10px rgba(0,0,0,.25)}
}
</style>
</head>
<body data-m="1">
<canvas id="map"></canvas>

<div id="top">
 <div id="topHeader">
  <div id="brand" data-tip="TERENITY" data-tip-desc="Kliknutím otevřete stručného průvodce aplikací a tipy k ovládání.">
   <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
     <linearGradient id="tGrad" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#4fc3f7"/>
      <stop offset="100%" stop-color="#0e7fa8"/>
     </linearGradient>
    </defs>
    <rect x="2" y="2" width="28" height="28" rx="8" fill="#101c2b" stroke="url(#tGrad)" stroke-width="2"/>
    <path d="M6 21C10 15 13 13 16 13C19 13 22 16 26 21" stroke="#4fc3f7" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M8 24.5C11.5 20.5 14 19 16 19C18 19 20.5 20.5 24 24.5" stroke="#3ddc8a" stroke-width="1.8" stroke-linecap="round" opacity=".85"/>
    <circle cx="22.5" cy="9.5" r="2.3" fill="#ffd54f"/>
   </svg>
   <span class="bt">TERENITY</span>
   <span class="sub">3D TERÉN &amp; LIDAR</span>
  </div>

  <div id="searchBox">
   <span id="searchIco">🔍</span>
   <input type="text" id="searchInp" placeholder="Hledat město, vrchol, hrad, místo…" autocomplete="off" data-tip="Vyhledávání místa" data-tip-desc="Zadejte název obce, hory, rozhledny nebo souřadnice a vyberte výsledek pro přesun mapy.">
   <button id="searchClr" title="Vymazat hledání">✕</button>
   <div id="searchRes"></div>
  </div>
 </div>

 <div id="tabs">
  <button data-m="1" class="on" data-tip="Režim Stín & Slunce" data-tip-desc="Simuluje dopad slunečních paprsků a stíny okolních kopců nad ortofotem ČÚZK.">☀ Stín</button>
  <button data-m="2" data-tip="Režim Terén & LIDAR" data-tip-desc="Zobrazuje výškopis, ČÚZK LIDAR DMR 5G reliéf, ortofoto ČÚZK, sklony a výškový profil A–B.">⛰ Terén</button>
  <button data-m="3" data-tip="Režim Viditelnost" data-tip-desc="Vypočítá přímou viditelnost z vybraného bodu nebo rozhledny až do 500 km (např. Alpy).">👁 Viditelnost</button>
  <button data-m="4" data-tip="Režim Závětří" data-tip-desc="Určí návětrné a závětrné svahy podle směru větru nad ortofotem ČÚZK – ideální pro hledání místa na bivak.">🌬 Závětří</button>
  <button data-m="5" data-tip="Vlastní body (Waypointy)" data-tip-desc="Ukládání vlastních offline bodů (bivak, bunkr, parkování) s exportem a importem GPX/JSON.">📌 Body</button>
 </div>

 <div id="status">
  <div class="st-loc">Klepněte na mapu pro výběr bodu.</div>
 </div>
</div>

<div id="fabs">
 <button id="fZi" data-tip="Přiblížit mapu" data-tip-desc="Přiblíží pohled na mapu blíže k terénu.">＋</button>
 <button id="fZo" data-tip="Oddálit mapu" data-tip-desc="Oddálí pohled na mapu pro širší přehled krajiny.">－</button>
 <button id="fGps" data-tip="Moje GPS poloha" data-tip-desc="Kliknutím zaměří vaši polohu z prohlížeče; dalším kliknutím modrý kruh GPS vypne.">📍</button>
 <button id="fPan" data-tip="Režim dotyku (1 prst)" data-tip-desc="Přepíná na dotykovém displeji mezi výběrem bodu jedním klepnutím a posouváním mapy jedním prstem.">☝</button>
 <button id="fRe" data-tip="Přepočítat výškový grid" data-tip-desc="Okamžitě stáhne a přepočítá výšková data pro aktuální výřez obrazovky.">⟳</button>
 <button id="fSet" data-tip="Nastavení aplikace" data-tip-desc="Konfigurace ortofota ČÚZK, OpenTopoMap / OpenStreetMap, vrstvy pojmenování, vrstevnic, gridu a offline krajů.">⚙</button>
</div>

<div id="scalebar"><span id="scTxt"></span><i id="scBar"></i></div>
<div id="busy">Počítám výškový grid…</div>
<div id="toast"></div>
<div id="hoverTip"></div>

<div id="sheet"><div id="grab">▾ panel ▾</div>

<section data-m="1">
 <div class="row">
  <input type="date" id="date" data-tip="Datum simulace" data-tip-desc="Zvolte den v roce pro výpočet dráhy slunce a délky stínů.">
  <button id="now" data-tip="Aktuální čas" data-tip-desc="Nastaví simulaci na dnešní datum a právě probíhající minutu.">Teď</button>
  <button id="play" data-tip="Přehrát pohyb slunce" data-tip-desc="Spustí plynulou animaci pohybu slunce a stínů během celého dne.">▶</button>
 </div>
 <div class="row"><span class="big" id="tlabel">12:00</span><input class="grow" type="range" id="time" min="0" max="1439" value="720" data-tip="Čas dne" data-tip-desc="Posuvníkem měníte denní dobu od 00:00 do 23:59."></div>
 <div class="row">
  <label class="grow" style="margin:0">Doplňkový podklad<select class="unified-basemap">
   <option value="none">Žádný (ortofoto ČÚZK)</option>
   <option value="otm">OpenTopoMap</option>
   <option value="osm">OpenStreetMap</option>
  </select></label>
  <label class="chk" style="margin:0"><input type="checkbox" class="unified-labels"> Pojmenování</label>
 </div>
 <div class="info" id="sunInfo"></div>
 <canvas class="ch" id="hzCanvas" style="height:170px"></canvas>
 <div class="info" id="sunEvents">Klepněte na mapu → analýza horizontu a východu/západu slunce za okolní terén.</div>
</section>

<section data-m="2">
 <div class="info" style="margin-top:0">Společný podklad ortofoto ČÚZK, vrstva pojmenování, LIDAR stínování a terénní analýzy pro všechny záložky.</div>
 <div class="row">
  <label class="chk grow" style="margin:0"><input type="checkbox" id="satOn"> 🛰 Ortofoto ČÚZK (podklad mapy)</label>
  <span style="font-size:12px;color:var(--mu)">krytí <b id="satOpacV">100</b>%</span>
 </div>
