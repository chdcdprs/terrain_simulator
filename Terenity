 basemap:'none',opac:55,contour:0,N:288,offline:false,auto:true,P0:1013.25,Tref:'',oneFinger:'act',slopeThr:25,hgtOn:true,
 labels:true,detail:'Default',lidarOn:true,lidarOpac:65,lidarBlend:'multiply',hypsoOn:false,windLidar:true,windLidarOpac:65,
